rules_version = '2';
// Firebase Console → Firestore Database → Rules ga shu matn qo'yiladi.
// izohlar — faqat admin; natijalar va xabarlar — har kim faqat yangisini qo'sha oladi, o'qish faqat admin;
// users/<uid> — har foydalanuvchi o'z yutuqlari, natijalari va rolini (o'quvchi/ustoz) o'qiydi/yozadi; admin hammasini o'qiydi va rol belgisi (arole) qo'yadi.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'akhmadaliyev7777@gmail.com';
    }
    match /izohlar/{id} {
      allow read, write: if isAdmin();
    }
    match /natijalar/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['k', 'h', 's', 'n', 't'])
        && request.resource.data.k is string && request.resource.data.k.size() < 120
        && request.resource.data.h is string && request.resource.data.h.size() < 20
        && request.resource.data.s is list && request.resource.data.s.size() <= 40
        && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 40
        && request.resource.data.t is timestamp;
    }
    match /users/{uid} {
      // o'quvchi o'zinikini; admin — hamma kirgan foydalanuvchilarning ismi, roli va natijalarini ko'radi (admin panel)
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      // role — foydalanuvchi o'zi tanlagan (oquvchi / ustoz); arole — faqat admin belgilaydi, foydalanuvchi o'zgartira olmaydi
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'p', 'r', 't', 'role'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.p is string && request.resource.data.p.size() < 500000
        && request.resource.data.r is string && request.resource.data.r.size() < 500000
        && (!('role' in request.resource.data) || request.resource.data.role in ['oquvchi', 'ustoz']);
      allow update: if (request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'p', 'r', 't', 'role', 'arole'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.p is string && request.resource.data.p.size() < 500000
        && request.resource.data.r is string && request.resource.data.r.size() < 500000
        && (!('role' in request.resource.data) || request.resource.data.role in ['oquvchi', 'ustoz'])
        && request.resource.data.get('arole', null) == resource.data.get('arole', null))
        || (isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['arole'])
        && (!('arole' in request.resource.data) || request.resource.data.arole in ['oquvchi', 'ustoz']));
    }
    match /xabarlar/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['k', 'bolim', 'matn', 'ism', 't', 'bajarildi'])
        && request.resource.data.k is string && request.resource.data.k.size() < 120
        && request.resource.data.bolim in ['maruza', 'interaktiv', 'test']
        && request.resource.data.matn is string && request.resource.data.matn.size() > 0 && request.resource.data.matn.size() <= 1000
        && request.resource.data.ism is string && request.resource.data.ism.size() <= 60
        && request.resource.data.t is timestamp
        && request.resource.data.bajarildi == false;
    }
  }
}
